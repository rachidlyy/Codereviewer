# Copy this file to `.env` and fill in the key.
#   cp .env.example .env
#
# The app runs fine with no .env at all: the AI reviewer falls back to a
# built-in rule-based reviewer so the full workflow still works offline.

# --- AI review ------------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
# When empty, the rule-based reviewer is used instead.
GEMINI_API_KEY=

# Leave this as the `-latest` alias unless you need a pinned version.
# Pinned names get retired for new API keys - gemini-2.5-flash now returns
# HTTP 404 "no longer available to new users", which breaks the review
# feature with no obvious clue. The alias always tracks the current flash
# model. Other options: gemini-flash-lite-latest, gemini-pro-latest
GEMINI_MODEL=gemini-flash-latest

# --- Fallback provider ----------------------------------------------------
# Optional. When Gemini exhausts its retries the review is retried once
# against Groq, which is a different company with its own quota - so Gemini
# being rate-limited no longer takes the review feature down with it.
# Get a free key at https://console.groq.com/keys (no credit card required).
#
# Groq's free tier is 30 requests/minute vs Gemini's 5, it sends a real
# Retry-After header, and it does not suffer the 503 "high demand" spikes.
# Leave blank to run Gemini-only, or leave both blank for the offline
# rule-based reviewer.
GROQ_API_KEY=

# Groq speaks the OpenAI chat-completions shape. Any of its chat models work;
# these are the ones on the free tier.
GROQ_MODEL=openai/gpt-oss-120b

# Per-attempt timeout, in seconds. The worst case before the request fails is
# roughly LLM_MAX_ATTEMPTS * (this + backoff), so it also bounds how long a
# stuck provider delays the Groq fallback. A healthy review takes 2-4s.
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.25

# Gemini's flash models intermittently return HTTP 503 "currently
# experiencing high demand". Those are transient, so the call is retried
# with exponential backoff instead of surfacing "AI Review temporarily
# unavailable" to the student. Set LLM_MAX_ATTEMPTS=1 to disable retrying.
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=1

# The free tier also caps requests per minute (observed: 5/minute for
# gemini-3.8-flash). A 429 is NOT like a 503 - the quota will not clear in a
# second or two, and the 429 body carries the real wait in
# error.details[].retryDelay ("50s") rather than a Retry-After header.
# Waits up to this many seconds are honoured; anything longer fails fast with
# a "retry in about Ns" message instead of holding the request open.
LLM_MAX_RETRY_WAIT_SECONDS=8

# --- Code execution -------------------------------------------------------
# Per-test-case time limit, in seconds. The Contains Duplicate "large input"
# case overrides this to 3s so an O(n^2) solution is reported as a timeout.
TEST_TIMEOUT_SECONDS=3

# Hard ceiling for a whole submission, in seconds.
SUBMISSION_TIMEOUT_SECONDS=20

# Interpreter used to run student code. Leave blank to reuse the interpreter
# that is running the API server (recommended).
PYTHON_EXECUTABLE=

# Node interpreter, used only when RUNNER_BACKEND=subprocess. Leave blank to
# find `node` on PATH, which is what the demo machine needs.
NODE_EXECUTABLE=

# --- Database (Phase 2) ---------------------------------------------------
# PostgreSQL 18 is already installed on this machine and runs as a service on
# port 5432. Create the role and database once:
#
#   psql -U postgres -c "CREATE ROLE codereviewer LOGIN PASSWORD 'choose-one';"
#   psql -U postgres -c "CREATE DATABASE codereviewer OWNER codereviewer;"
#
# `psql` is not on PATH here; the binary lives at
#   C:\Program Files\PostgreSQL\18\bin\psql.exe
#
# The `+psycopg` suffix selects the psycopg v3 driver. Do not drop it - plain
# `postgresql://` makes SQLAlchemy reach for psycopg2, which is not installed.
#
# Then apply the schema:  .venv/Scripts/python.exe -m alembic upgrade head
DATABASE_URL=postgresql+psycopg://codereviewer:CHANGE_ME@127.0.0.1:5432/codereviewer

# Log every SQL statement. Very noisy, debugging only.
DB_ECHO=false

# --- Auth (Phase 2) -------------------------------------------------------
# Clerk owns sign-up, sign-in and password storage. Sign-in is mandatory, so
# the app is not usable until this is set.
#
# Create a free application at https://dashboard.clerk.com and use its
# DEVELOPMENT instance keys (`sk_test_...` / `pk_test_...`). Development keys
# work on localhost with no domain allowlist, which is what you want here.
#
# The publishable key goes in frontend/.env as VITE_CLERK_PUBLISHABLE_KEY.
CLERK_SECRET_KEY=

# Comma-separated origins a session token may be used from.
#
# Clerk rejects a token whose `azp` claim is not listed here, and it presents
# as a plain 401 even though the token is valid - which looks exactly like a
# wrong secret key. Only change this if the frontend runs elsewhere.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173

# --- Server ---------------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true to include extra debug logging.
DEBUG=false

# --- Execution sandbox (Phase 2) ------------------------------------------
# Student code runs in a hardened container: no network, one CPU, a 512m memory
# ceiling, a 128-process limit, a read-only filesystem and a size-capped tmpfs
# for the one writable directory.
#
# There is one image per language and BOTH must be built, from the repository
# root:
#   docker build -f docker/runner-python/Dockerfile -t codereviewer-runner-python .
#   docker build -f docker/runner-node/Dockerfile   -t codereviewer-runner-node   .
#
# They are separate rather than one combined image because the container *is*
# the security boundary: an image carrying both runtimes would let a Python
# submission reach Node. It also keeps each image small, and keeps the Java and
# C++ toolchains due in a later phase from producing one ~1.5 GB image.
#
# `docker` is the default and the only backend that isolates student code.
RUNNER_BACKEND=docker

# `subprocess` runs student code directly on this machine, with no sandbox at
# all. It exists because Docker Desktop on Windows is the least reliable part
# of the stack, and a demo that cannot run is worse than a demo without a
# sandbox. Use it deliberately, not as a silent fallback - a downgrade from
# "sandboxed" to "runs arbitrary code on the host" should never happen without
# someone choosing it.
#
# The choice is never made automatically. With RUNNER_BACKEND=docker and the
# daemon down, every run fails loudly and /api/health reports docker_ok=false.
# RUNNER_BACKEND=subprocess

# Runner images, if you tagged them something else. One per language, because a
# submission chooses its language and each sandbox carries only its own runtime.
RUNNER_IMAGE_PYTHON=codereviewer-runner-python
RUNNER_IMAGE_NODE=codereviewer-runner-node

# Legacy alias, honoured as the Python entry's default so an existing .env keeps
# working. The per-language variables above win over it.
# RUNNER_IMAGE=codereviewer-runner-python

# Ceiling on memory per submission. A submission that tries to exceed it is
# killed by the kernel inside the container rather than swapping this machine.
RUNNER_MEMORY_LIMIT=512m

# CPU quota. One core keeps a runaway loop from starving the API server.
RUNNER_CPUS=1

# Process ceiling, so a fork bomb cannot exhaust the host's process table.
RUNNER_PIDS_LIMIT=128

# Size of the one writable mount inside the container. The root filesystem is
# read-only, so this is the only place a submission can write.
RUNNER_TMPFS_SIZE=128m

# Docker CLI, if it is not on PATH.
DOCKER_BINARY=docker

# Extra seconds allowed on top of SUBMISSION_TIMEOUT_SECONDS for the container
# to start and be torn down. The per-case limits are enforced inside the
# container, so this is only a backstop against the container hanging.
#
# Note the container costs roughly 2s to create and destroy on Windows. That
# is the price of the sandbox and it is paid once per submission, not per case.
DOCKER_STARTUP_GRACE_SECONDS=15
