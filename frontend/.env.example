# Copy to `.env` if your backend runs somewhere other than the default.
#   cp .env.example .env
#
# The frontend falls back to http://127.0.0.1:8000 when this is not set,
# which matches the backend's default `uvicorn` port.

VITE_API_URL=http://127.0.0.1:8000

# --- Auth (Phase 2) -------------------------------------------------------
# Clerk publishable key for the same application as the backend's
# CLERK_SECRET_KEY. Use the development instance (`pk_test_...`).
#
# Get it from https://dashboard.clerk.com -> your app -> API Keys.
#
# This key is PUBLIC by design - it is shipped to the browser and is not a
# secret. The matching secret key stays server-side in backend/.env.
#
# Vite only exposes variables prefixed with VITE_, so this name cannot be
# shortened to CLERK_PUBLISHABLE_KEY.
VITE_CLERK_PUBLISHABLE_KEY=
